{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the 一步 desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:scope-desktop",
    "fs:scope-document",
    "fs:scope-download",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-load"
  ]
}
